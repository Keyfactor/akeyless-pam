# Copy this file to get-secret-field.env (gitignored via *.env) and fill in
# real values. Variables here are picked up by get-secret-field.ps1 and
# get-secret-field.sh instead of editing the hardcoded placeholders in the
# scripts themselves.

AKEYLESS_URL=https://api.akeyless.io
AKEYLESS_ACCESS_ID=p-xxxxxxxx
AKEYLESS_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AKEYLESS_SECRET_NAME=/path/to/my-kv-secret
AKEYLESS_FIELD_NAMES=username,password
